{
  "name": "rishta-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:backend": "npm --workspace=backend run start",
    "dev:public": "npm --workspace=apps/web-public run dev",
    "dev:app": "npm --workspace=apps/web-app run dev",
    "dev:admin": "npm --workspace=apps/web-admin run dev",
    "dev:mobile": "npm --workspace=apps/mobile-app run start",
    "start:public": "npm --workspace=apps/web-public run start",
    "start:app": "npm --workspace=apps/web-app run start",
    "start:admin": "npm --workspace=apps/web-admin run start"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}